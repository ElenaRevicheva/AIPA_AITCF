   {
    "parameters": {
     "jsCode": "// 29 Oct 2026: reads Elena's own CRM (daily_queue + EspaLuz truth_people), not HubSpot.\n// Same 8 fields as the August version, so the ops dashboard needs no change.\nconst q = $('CRM queue (today)').first().json || {};\nlet esp = {};\ntry { esp = $('CRM EspaLuz (verified)').first().json || {}; } catch (err) { esp = {}; }\nconst hs = id => id ? `https://app.hubspot.com/contacts/51409153/record/0-3/${id}` : '';\nconst out = [];\nfor (const [lane, stream] of [['hiring', 'HIRING'], ['client', 'CLIENT']]) {\n  for (const x of (q[lane] || [])) {\n    out.push({ json: {\n      id: x.id, stream, summary: x.title || '', company: x.company || '', stage: x.status || 'new',\n      scoreOrUrgency: x.draftTailored ? 'draft ready' : (x.score != null ? String(x.score) : ''),\n      primaryUrl: x.actionUrl || hs(x.hubspotDealId), updatedAt: x.createdAt || '', needsAction: true,\n    } });\n  }\n}\nfor (const p of (esp.people || [])) {\n  const k = String(p.contact || '');\n  out.push({ json: {\n    id: k, stream: 'ESPALUZ', summary: p.name || k.slice(3), company: (p.channels || []).join(' \u00b7 '),\n    stage: `trial ${p.trial_state} \u00b7 ${String(p.paid_state || '').replace(/_/g, ' ')}`,\n    scoreOrUrgency: p.alive ? 'active this month' : '',\n    primaryUrl: k.startsWith('wa:') ? `https://wa.me/${k.slice(3)}` : (k.startsWith('em:') ? `mailto:${k.slice(3)}` : ''),\n    updatedAt: p.last_active || '', needsAction: Boolean(p.alive),\n  } });\n}\nreturn out;\n"
    },
