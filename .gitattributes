# Shell scripts must use LF so they run on Oracle (Linux)
scripts/oracle-resilience/*.sh text eol=lf
scripts/aigo-frame-sheet12.sh text eol=lf

# Binary assets — NEVER line-ending-converted. core.autocrlf=true on Windows treats a
# reportlab PDF as text and would rewrite bytes inside it on the next checkout, producing
# a file that no longer opens. Same trap that corrupted a named-file sync in Sep 2026.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.zip   binary
*.mp4   binary
*.docx  binary

# film #9 helper scripts run in Git Bash on the laptop: CRLF would break them
docs/atuona/film9_stanza_work/*.sh text eol=lf
